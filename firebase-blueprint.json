{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile authenticated via Firebase",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    },
    "Order": {
      "title": "Order",
      "description": "Google AI Pro subscription order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "productTitle": { "type": "string" },
        "planDuration": { "type": "string" },
        "cloudStorage": { "type": "string" },
        "seats": { "type": "number" },
        "priceETB": { "type": "number" },
        "targetGmail": { "type": "string", "format": "email" },
        "paymentMethod": { "type": "string", "enum": ["telebirr", "cbe", "abyssinia"] },
        "paymentReference": { "type": "string" },
        "senderPhone": { "type": "string" },
        "status": { "type": "string", "enum": ["pending_verification", "dispatching", "activated", "expired"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "redeemLink": { "type": "string" },
        "slaDeadline": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      },
      "required": ["id", "userId", "targetGmail", "paymentMethod", "priceETB", "status", "createdAt"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Customer inquiry or custom quote request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "teamSize": { "type": "number" },
        "intendedUse": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Conversation history with Amir Plus AI consultant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "messages": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile records"
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Orders placed by the authenticated user"
    },
    "/users/{userId}/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Inquiries submitted by the user"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "AI consultant chat history"
    }
  }
}
